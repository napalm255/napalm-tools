{
  "name": "napalm-tools",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "remoteUser": "dev",
  "runArgs": ["--userns=keep-id"],
  "workspaceFolder": "/workspaces/napalm-tools",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/napalm-tools,type=bind,Z",
  "postCreateCommand": "mise trust --quiet && mise install --yes just && just setup",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"]
    }
  }
}
